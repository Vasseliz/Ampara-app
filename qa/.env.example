# =========================================================================
# Playwright (Stack 1 Web) — usado por src/config/env.ts e playwright.config.ts
# =========================================================================
PW_HOMOLOG=dev

# Front web (Vite) e backend .NET (fonte da verdade)
PW_BASE_URL=http://localhost:5173/
PW_API_URL=http://localhost:5243

# Credenciais por perfil (usuários seed já existentes no ambiente)
PW_PACIENTE_EMAIL=paciente@ampara.test
PW_PACIENTE_PASSWORD=troque-me
PW_PROFISSIONAL_EMAIL=profissional@ampara.test
PW_PROFISSIONAL_PASSWORD=troque-me

# Execução
PW_WORKERS=4
PW_HEADLESS=true
PW_TEST_TIMEOUT=90000
PW_NAVIGATION_TIMEOUT=45000
PW_ACTION_TIMEOUT=15000
PW_EXPECT_TIMEOUT=15000

# =========================================================================
# Fundação (seed) — usado por src/seed/config.ts
# =========================================================================
E2E_API_URL=http://localhost:5243
E2E_SUPABASE_URL=https://<project>.supabase.co
E2E_SUPABASE_ANON_KEY=<anon-key>
# Opcional: habilita deletar usuários no cleanup (admin). Sem ela, usuários de
# teste permanecem (inofensivos — e-mails têm runId único).
E2E_SUPABASE_SERVICE_ROLE_KEY=
