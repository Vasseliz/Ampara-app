# Variáveis Maestro da Track B. Os flows NÃO têm default — você DEVE passá-las com
# `-e CHAVE=valor` (CLI ou Bloco J). Maestro não lê este arquivo; ele só documenta
# as chaves esperadas. (Defaults no `env:` do flow venceriam o `-e`, então não há.)

# Credenciais de um PACIENTE já registrado (login por UI).
# Isolado: rode flows/auth/cadastro.yaml ou registre um paciente fixo.
# Bloco J: injetado a partir de seedParVinculado() da Fundação.
EMAIL=paciente.e2e@ampara.test
PASSWORD=SenhaForte123!

# Token de um convite PENDENTE para esse paciente (deep link de aceite).
# Isolado: crie um convite via API/web e copie o token.
# Bloco J: injetado a partir do seed.
INVITE_TOKEN=cole-o-token-do-convite-aqui
